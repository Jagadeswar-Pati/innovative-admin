# Admin panel — copy to .env (do not commit .env)

# Main backend API (required in production). Include /api suffix.
VITE_API_BASE_URL=http://localhost:5000/api

# Used by some admin helpers; base URL without path, no trailing slash.
VITE_API_URL=http://localhost:5000

# Optional: Resources Hub admin (only if you run extras/resourcesi stack)
VITE_RESOURCES_ADMIN_API_URL=http://localhost:5001/api/resources/admin
VITE_RESOURCES_ADMIN_KEY=your-admin-secret
